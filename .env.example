# ฐานข้อมูลของแอปนี้เอง (แยกจากระบบ LINE)
DATABASE_URL=postgres://customer_data:CHANGE_ME@127.0.0.1:5432/customer_data
PORT=3100
# รหัสเข้าใช้หน้าเว็บ (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME

# sync ทุกคืน (เวลาไทย) — ใส่ SYNC_ENABLED=false เพื่อปิด
SYNC_ENABLED=true
SYNC_CRON=0 2 * * *
# เว้นระหว่างแต่ละเบอร์ (ms) 500 = ~120 ครั้ง/นาที (ลิมิตเว็บ 600/นาที/IP)
SYNC_DELAY_MS=500
SYNC_TIMEOUT_MS=15000
SYNC_MAX_HOURS=5
# เว็บไหน error ติดกันกี่ครั้งแล้วหยุดยิงเว็บนั้นในรอบนั้น
SYNC_MAX_SITE_ERRORS=10

# ดึงรายการฝาก/ถอน (report-deposit / report-withdraw) เพื่อเติมรายชื่อเบอร์อัตโนมัติ
TX_ENABLED=true
# ครั้งแรกย้อนหลังกี่เดือน
TX_HISTORY_MONTHS=1
# ลิมิตเว็บ 60 ครั้ง/นาที/IP (รวม 3 เส้น) → 1100ms ≈ 55 ครั้ง/นาที
TX_DELAY_MS=1100
